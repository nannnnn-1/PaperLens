# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=parse:queue

# Nest.js callback
NEST_API_URL=http://localhost:3000
NEST_CALLBACK_PATH=/api/v1/parse/callback

# OpenAI-compatible LLM (chat / translation / term extraction)
# Supports DeepSeek, OpenAI, Moonshot, vLLM, etc.
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# OpenAI-compatible Embedding (can be a different provider)
# DeepSeek API does NOT support embeddings as of 2026-06.
# Use OpenAI, DashScope, SiliconFlow, or a local model for embeddings.
OPENAI_EMBEDDING_API_KEY=sk-your-key
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Timeouts and retries
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
PDF_DOWNLOAD_TIMEOUT=120

# Worker
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
